{
  "name": "k-plex",
  "version": "1.0.0",
  "description": "A TheBrain-inspired visual knowledge navigator for Obsidian, rebuilt in React.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check:architecture": "node --test tests/architecture.test.mjs && node scripts/check-architecture.mjs",
    "verify": "npm run check:architecture && npm test && npm run build",
    "repo:export": "node scripts/generate-repository-zip.mjs",
    "repo:update": "node scripts/update-repository.mjs",
    "test": "node scripts/run-indexing-tests.mjs"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "keywords": [
    "obsidian",
    "knowledge-graph",
    "pkm",
    "react"
  ],
  "author": "Zsolt Viczian",
  "license": "MIT",
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "esbuild": "0.25.5",
    "obsidian": "1.13.0",
    "typescript": "^5.8.3"
  }
}
